  "normalization": {
    "screen_width": 256,
    "screen_height": 224,
    "max_powerup": 3,
    "tile_categories_count": 16,
    "max_sprite_id": 255,
    "sprite_status_active_min": 8,
    "max_sprite_hitbox_dimension": 128,
    "grid_size": 21,
    "tile_size": 16
  },

  "rewards": {
    "_comment": "x_progress_per_pixel: reward only for NEW max X (no backtracking reward)",
    "x_progress_per_pixel": 0.3,
    "y_progress_per_pixel": 0.3,
    "goal_reached": 1000.0,
