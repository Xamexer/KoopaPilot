    "time_penalty_per_step": -0.01,
    "teleport_threshold_pixels": 256
  },

  "ppo": {
    "learning_rate": 2.5e-4,
    "lr_schedule": "linear",
    "n_steps": 128,
    "batch_size": 256,
    "n_epochs": 4,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.1,
    "clip_range_schedule": "linear",
    "ent_coef": 0.01,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "target_kl": 0.03,
    "frame_stack": 4,
    "policy_kwargs": {
      "net_arch": {
        "pi": [512, 256],
        "vf": [512, 256]
      }
    },
    "total_timesteps": 2500000,
    "save_interval_steps": 100000,
    "max_episode_steps": 1024,
    "stagnation_timeout_steps": 300
  },

  "dashboard": {
    "host": "127.0.0.1",
    "port": 8080,
    "poll_interval_seconds": 5
